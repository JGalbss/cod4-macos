	w[231] = jevWaypoint((909.157, -334.45, 0.125), "230 198 197", "stand");
	w[232] = jevWaypoint((1082.27, 408.168, 0.125), "215 174 124", "stand");
	w[233] = jevWaypoint((2132.39, 1202.44, -146.375), "68 69 234", "stand");
	w[234] = jevWaypoint((1741.45, 1157.14, -147.875), "233 105", "stand");
	w[235] = jevWaypoint((1470.12, 200.984, 0.124999), "236 171", "stand");
	w[236] = jevWaypoint((1473.04, 366.543, -66.875), "235 112", "stand");
	return w;
}

jevWaypoint(origin, children, type)
{
	n = spawnStruct();
	n.origin = origin; n.type = type; n.children = [];
	if (children != "") { toks = strTok(children, " "); for (i = 0; i < toks.size; i++) n.children[i] = int(toks[i]); }
	return n;
}
